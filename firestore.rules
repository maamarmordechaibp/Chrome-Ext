rules_version = '2';

// Firestore security rules for the Marketplace Catalog Generator.
//
// Model: every user document records the team they belong to. All catalog data
// is stored under teams/{teamId}/catalogs/{catalogId}, so any signed-in member
// of a team can read/write that team's catalogs — and NO ONE can read another
// team's data. This makes the app multi-tenant and safe to share.
//
// Deploy: Firebase console -> Firestore Database -> Rules -> paste -> Publish.

service cloud.firestore {
  match /databases/{database}/documents {

    // The signed-in user's team id (or null if no profile yet).
    function myTeamId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.teamId;
    }

    function signedIn() {
      return request.auth != null;
    }

    // Teams: readable by signed-in users (needed to resolve the caller's team).
    // Creation and changes happen ONLY through the admin backend, whose
    // service-account writes bypass these rules. Clients may not write.
    match /teams/{teamId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Per-company delivery credentials (Resend + SignalWire API keys, from
    // address). NEVER readable or writable by any client — only the admin
    // backend's service account touches these (its writes bypass rules). Kept
    // in a separate collection so members reading teams/{teamId} for branding
    // can never see the secrets.
    match /team_secrets/{teamId} {
      allow read, write: if false;
    }

    // User profiles: a user may READ only their own profile. Profiles are
    // provisioned and modified only by the admin backend, so clients may not
    // create, update, or delete them.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Catalog data is scoped per team. Any member of the team may read and
    // write; members of other teams are denied.
    match /teams/{teamId}/catalogs/{catalogId} {
      allow read, write: if signedIn() && myTeamId() == teamId;
    }
  }
}
